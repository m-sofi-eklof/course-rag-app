# Postgres (Supabase/Neon free tier in prod, local docker-compose in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/course_rag

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Hosted APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Backend
JAVA_BACKEND_PORT=8080
JWT_SECRET=

# Worker
WORKER_POLL_INTERVAL_SECONDS=5

# Postgres (Supabase/Neon free tier in prod, local docker-compose in dev)
# libpq format — used by the Python worker (psycopg3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/course_rag
# JDBC format — used by the Java backend (Spring Boot datasource)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/course_rag
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Object storage — Cloudflare R2 in prod, MinIO locally (docker compose up minio)
# Prod:  R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Local: R2_ENDPOINT_URL=http://localhost:9000
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Hosted APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Backend
JAVA_BACKEND_PORT=8080
JWT_SECRET=

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
